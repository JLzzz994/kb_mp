# 应用基础配置
APP_NAME=huice-erp-wms-knowledge-ops
DEBUG=false
LOG_LEVEL=INFO

# 数据库（MySQL + aiomysql）
DATABASE_URL=mysql+aiomysql://kb_user:kb_password@localhost:3306/kb_mp

# LLM（OpenAI-compatible）：回答 + Query Rewrite / HyDE
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3

# Embedding / Milvus
EMBEDDING_BACKEND=local_bge
BGE_M3_PATH=D:/ai_models/modelscope_cache/models/BAAI/bge-m3
BGE_DEVICE=cpu
MILVUS_URL=http://localhost:19530
MILVUS_COLLECTION=kb_units

# BGE-Reranker：disabled 时仍保留 RRF 排名 + 动态截断
RERANK_BACKEND=disabled
BGE_RERANKER_PATH=D:/ai_models/modelscope_cache/models/rerank/BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu

# 混合检索
QUERY_REWRITE_ENABLED=true
HYDE_ENABLED=true
RETRIEVAL_KEYWORD_TOP_K=20
RETRIEVAL_VECTOR_TOP_K=20
RETRIEVAL_FUSED_TOP_K=20
RETRIEVAL_RRF_K=60
RERANK_TOP_K=8
RERANK_MIN_KEEP=2
RERANK_CLIFF_RATIO=0.75
RERANK_MIN_SCORE=0.2
